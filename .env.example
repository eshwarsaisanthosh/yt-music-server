# Copy to .env and adjust. All settings use the YTM_ prefix.
# Data locations (host paths when running locally; /data inside docker-compose)
YTM_DATA_ROOT=./data

# Optional bearer token. When set, every /v1/* endpoint requires
#   Authorization: Bearer <token>
# Leave empty only on a trusted private network.
YTM_API_TOKEN=

# Worker behavior
YTM_WORKER_POLL_INTERVAL_S=2.0
YTM_JOB_MAX_ATTEMPTS=5
YTM_RETRY_BASE_DELAY_S=30.0
YTM_RETRY_MAX_DELAY_S=1800.0

# Pipeline guards
YTM_MAX_VIDEO_DURATION_S=21600
YTM_MIN_TRACK_DURATION_S=3.0

YTM_LOG_LEVEL=INFO
